    "settings": {
      "git.quickDiffBase": {
        "type": "string",
        "enum": ["index", "head", "mergeBase"],
        "enumDescriptions": [
          "Unstaged changes (VS Code)",
          "Every uncommitted change",
          "Everything since the branch left the default branch (what a pull request shows)"
        ],
        "default": "index",
        "description": "What the editor's change bars compare the file with."
      },
      "git.autofetch": {
        "type": "boolean",
        "default": false,
        "description": "Fetch from the remote every git.autofetchPeriod seconds, so the behind count stays current. Quiet; it stops after a failed sign-in until your next fetch."
      },
      "git.autofetchPeriod": {
        "type": "number",
        "default": 180,
        "minimum": 30,
        "description": "Seconds between automatic fetches (git.autofetch)."
      },
      "git.enableCommitSigning": {
        "type": "boolean",
        "default": false,
        "description": "Sign commits (git commit -S) with your configured GPG or SSH key. git's own commit.gpgsign works without this."
      },
      "git.alwaysSignOff": {
        "type": "boolean",
        "default": false,
        "description": "Add a Signed-off-by line to every commit (git commit --signoff)."
      },
      "git.defaultCloneDirectory": {
        "type": "string",
        "default": "",
        "scope": "user",
        "description": "Where \"Clone repository\" starts looking for the folder to clone into."
      },
      "git.blame.editorDecoration.enabled": {
        "type": "boolean",
        "default": false,
        "description": "Show who last changed the cursor's line, and when, as faint text at the end of the line."
      },
      "git.blame.statusBarItem.enabled": {
        "type": "boolean",
        "default": true,
        "scope": "user",
        "description": "Show who last changed the cursor's line (git blame) in the status bar."
      },
      "git.aiCommitMessage.enabled": {
        "type": "boolean",
        "default": true,
        "description": "Generate commit message: a button in the commit box writes the message from the staged changes with your model, only when you press it. Off: no AI button in Source control.",
        "order": 4,
        "category": "AI features",
        "section": "Commit messages",
        "title": "Generate commit message"
      },
      "git.aiCommitMessage.model": {
        "type": "string",
        "default": "",
        "scope": "user",
        "description": "Model for Generate commit message, as provider/model (e.g. ollama/qwen3:8b). Empty: the agent's model. Also on the AI models page.",
        "order": 5,
        "category": "AI features",
        "section": "Commit messages",
        "title": "Model"
      },
      "git.graph.enabled": {
        "type": "boolean",
        "default": true,
        "description": "Draw the commit graph (branch lines) in Source control's Graph.",
        "order": 40
      },
      "git.graph.allBranches": {
        "type": "boolean",
        "default": false,
        "description": "The commit graph shows every branch, tag and remote branch, not only the current branch and its upstream.",
        "order": 41
      },
      "git.graph.pageOnScroll": {
        "type": "boolean",
        "default": true,
        "description": "The commit graph lists the next page of commits when you scroll to its end (VS Code's scm.graph.pageOnScroll), instead of waiting for Show more commits.",
        "order": 42
      },
      "github.statusBar.enabled": {
        "type": "boolean",
        "default": true,
        "description": "Show the current branch's GitHub pull request in the status bar (needs the GitHub CLI, gh, signed in).",
        "order": 42
      },
      "scm.repositories.selectionMode": {
        "type": "string",
        "enum": ["single", "multiple"],
        "default": "single",
        "description": "With several repositories in the folder: \"single\" shows the selected repository's changes (pick it in the Repositories list); \"multiple\" shows every repository's changes in one list, each under its own row (VS Code's). The message box commits the selected one either way.",
        "order": 44
      },
      "git.repositoryScanMaxDepth": {
        "type": "number",
        "default": 1,
        "minimum": 0,
        "maximum": 8,
        "description": "How many folders deep to look for other git repositories inside the open folder (0: none). Each one gets its own changes, branch and commit box in Source control.",
        "order": 43
      },
      "git.repositoryScanIgnoredFolders": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["node_modules"],
        "description": "Folder names never looked into for repositories.",
        "order": 44
      },
      "git.detectSubmodules": {
        "type": "boolean",
        "default": true,
        "description": "List the repository's submodules in Source control (up to 10).",
        "order": 45
      }
    },
    "keybindings": [
      {
        "key": "ctrl+shift+g",
        "mac": "ctrl+shift+g",
        "command": "git.showView"
      },
      {
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "command": "git.commit",
        "when": "scmMessageFocus"
      }
    ]
