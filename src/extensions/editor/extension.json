    "keybindings": [
      {
        "key": "ctrl+k ctrl+v",
        "mac": "cmd+k cmd+v",
        "command": "editor.pasteFromHistory",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+k ctrl+w",
        "mac": "cmd+k cmd+w",
        "command": "editor.closeAll",
        "when": "activeEditor"
      },
      {
        "key": "ctrl+k m",
        "mac": "cmd+k m",
        "command": "editor.setLanguage",
        "when": "activeEditor"
      },
      {
        "key": "ctrl+k s",
        "mac": "alt+cmd+s",
        "command": "editor.saveAll",
        "when": "activeEditor"
      },
      {
        "key": "alt+left",
        "mac": "ctrl+-",
        "command": "workbench.navigateBack",
        "when": "canNavigateBack && !terminalFocus"
      },
      {
        "key": "alt+right",
        "mac": "ctrl+shift+-",
        "command": "workbench.navigateForward",
        "when": "canNavigateForward && !terminalFocus"
      },
      {
        "key": "ctrl+alt+pagedown",
        "mac": "ctrl+alt+pagedown",
        "command": "editor.multiDiff.nextFile",
        "when": "activeMultiDiff"
      },
      {
        "key": "ctrl+alt+pageup",
        "mac": "ctrl+alt+pageup",
        "command": "editor.multiDiff.previousFile",
        "when": "activeMultiDiff"
      },
      {
        "key": "alt+\\",
        "command": "editor.inlineSuggest.trigger",
        "when": "editorFocus && aiInlineCompletions"
      },
      {
        "key": "ctrl+f",
        "mac": "cmd+f",
        "command": "notebook.find",
        "when": "activeNotebook"
      },
      {
        "key": "ctrl+h",
        "mac": "alt+cmd+f",
        "command": "notebook.find",
        "args": { "replace": true },
        "when": "activeNotebook && !sideBarFocus"
      },
      {
        "key": "ctrl+s",
        "mac": "cmd+s",
        "command": "notebook.save",
        "when": "activeNotebook"
      },
      {
        "key": "ctrl+n",
        "mac": "cmd+n",
        "command": "workspace.newUntitledFile",
        "when": "!terminalFocus || isMac"
      },
      {
        "key": "ctrl+s",
        "mac": "cmd+s",
        "command": "editor.save",
        "when": "activeEditor"
      },
      {
        "key": "ctrl+alt+s",
        "mac": "alt+cmd+s",
        "command": "editor.saveAll",
        "when": "activeEditor"
      },
      {
        "key": "ctrl+g",
        "mac": "ctrl+g",
        "command": "editor.gotoLine",
        "when": "editorFocus"
      },
      {
        "key": "ctrl+shift+m",
        "mac": "shift+cmd+m",
        "command": "problems.show"
      },
      {
        "key": "ctrl+k",
        "mac": "cmd+k",
        "command": "editor.inlineEdit",
        "when": "editorFocus && aiInlineEdit && !inlineEditVisible"
      },
      {
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "command": "editor.inlineEdit.accept",
        "when": "inlineEditReview && editorFocus"
      },
      {
        "key": "escape",
        "command": "editor.inlineEdit.reject",
        "when": "inlineEditVisible && editorFocus"
      }
    ],
    "settings": {
      "notebook.languageServer.enabled": {
        "type": "boolean",
        "default": true,
        "description": "Language servers in notebook cells (as VS Code does for Python): the code cells go to the language's server (Pyright, pylsp…) as one document, so errors show in the cells and in Problems, and hover, completion, go to definition, references and rename work across cells."
      },
      "notebook.lineNumbers": {
        "type": "string",
        "enum": ["off", "on"],
        "default": "off",
        "description": "Line numbers in notebook cells' editors (L toggles one cell's, Shift+L every cell's, as in VS Code)."
      },
      "notebook.output.scrolling": {
        "type": "boolean",
        "default": true,
        "description": "Long outputs scroll inside their cell instead of making it as tall as they are."
      },
      "notebook.output.cdn": {
        "type": "string",
        "default": "https://cdn.jsdelivr.net/npm/",
        "description": "Where interactive outputs load their libraries from (Jupyter widgets, Plotly), as an npm CDN URL ending in /. Point it at a mirror if jsDelivr is blocked where you work."
      },
      "editor.fontSize": {
        "type": "integer",
        "default": 14,
        "minimum": 6,
        "maximum": 72,
        "description": "Font size in pixels.",
        "order": 1
      },
      "editor.tabSize": {
        "type": "integer",
        "default": 4,
        "minimum": 1,
        "maximum": 16,
        "description": "Spaces per tab (files may override it).",
        "order": 2
      },
      "editor.wordWrap": {
        "type": "string",
        "enum": ["off", "on"],
        "default": "on",
        "description": "Wrap long lines at the editor's width.",
        "order": 3
      },
      "editor.stickyScroll.enabled": {
        "type": "boolean",
        "default": true,
        "description": "Keep the enclosing function and class names pinned at the top while scrolling.",
        "order": 4
      },
      "editor.minimap.enabled": {
        "type": "boolean",
        "default": true,
        "description": "Show the minimap.",
        "order": 5
      },
      "editor.renderWhitespace": {
        "type": "string",
        "enum": ["none", "boundary", "selection", "all"],
        "default": "selection",
        "description": "When to draw whitespace characters.",
        "order": 6
      },
      "editor.hideSecrets": {
        "type": "boolean",
        "default": false,
        "description": "Cover the values in secret files (editor.secretFiles: .env files, keys, certificates) except on the line the cursor is on. For screen sharing and streaming; copying still copies the real text.",
        "order": 6.1
      },
      "editor.secretFiles": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["**/.env*", "**/*.pem", "**/*.key", "**/*.cert", "**/*.crt", "**/secrets.yml"],
        "description": "Glob patterns of the files whose values editor.hideSecrets covers.",
        "order": 6.2
      },
      "diffEditor.renderSideBySide": {
        "type": "boolean",
        "default": true,
        "description": "Show diffs side by side (else inline). A narrow diff view goes inline anyway.",
        "order": 60
      },
      "diffEditor.ignoreTrimWhitespace": {
        "type": "boolean",
        "default": true,
        "description": "Diffs ignore changes of leading and trailing whitespace.",
        "order": 61
      },
      "diffEditor.hideUnchangedRegions.enabled": {
        "type": "boolean",
        "default": false,
        "description": "Diffs fold long stretches of unchanged lines.",
        "order": 62
      },
      "editor.codeActionsOnSave": {
        "type": "object",
        "default": {},
        "description": "Code actions run before saving, from the language services: { \"source.organizeImports\": \"explicit\", \"source.fixAll\": \"explicit\" }. \"explicit\" on Ctrl+S, \"always\" with auto-save too, \"never\" off.",
        "order": 4
      },
      "files.encoding": {
        "type": "string",
        "enum": [
          "utf8",
          "windows-1252",
          "iso-8859-1",
          "iso-8859-3",
          "iso-8859-15",
          "macintosh",
          "windows-1250",
          "iso-8859-2",
          "windows-1251",
          "iso-8859-5",
          "koi8-r",
          "koi8-u",
          "ibm866",
          "x-mac-cyrillic",
          "windows-1253",
          "iso-8859-7",
          "windows-1254",
          "windows-1255",
          "iso-8859-8",
          "iso-8859-8-i",
          "windows-1256",
          "iso-8859-6",
          "windows-1257",
          "iso-8859-4",
          "iso-8859-13",
          "iso-8859-10",
          "iso-8859-14",
          "iso-8859-16",
          "windows-1258",
          "windows-874",
          "shift_jis",
          "euc-jp",
          "iso-2022-jp",
          "gbk",
          "gb18030",
          "big5",
          "euc-kr"
        ],
        "default": "utf8",
        "description": "How files that aren't valid UTF-8 are read and saved (UTF-8 and UTF-16 files with a BOM are always read as such). With UTF-8 they open read-only until you pick an encoding (status bar).",
        "order": 2
      },
      "files.autoGuessEncoding": {
        "type": "boolean",
        "default": false,
        "description": "Guess the encoding of files that aren't UTF-8 from their content (UTF-16 without a BOM, Japanese, Chinese, Korean, Cyrillic, Western and the other legacy encodings). The guess wins over files.encoding.",
        "order": 3
      },
      "files.eol": {
        "type": "string",
        "enum": ["auto", "\n", "\r\n"],
        "enumDescriptions": ["Keep each file's line endings; new files use LF", "LF", "CRLF"],
        "default": "auto",
        "description": "Line endings for new files.",
        "order": 1
      },
      "files.insertFinalNewline": {
        "type": "boolean",
        "default": false,
        "description": "Make sure files end with a newline when saved.",
        "order": 2
      },
      "files.trimTrailingWhitespace": {
        "type": "boolean",
        "default": false,
        "description": "Remove trailing whitespace when saving.",
        "order": 3
      },
      "files.readonlyInclude": {
        "type": "object",
        "default": {},
        "description": "Glob patterns of files that open read-only (true makes them so), matched against the path in the folder or the absolute path: { \"**/generated/**\": true }. \"Set active editor writeable in session\" overrides it for a file.",
        "order": 3.1
      },
      "files.readonlyExclude": {
        "type": "object",
        "default": {},
        "description": "Glob patterns of files that stay editable although files.readonlyInclude matches them.",
        "order": 3.2
      },
      "files.readonlyFromPermissions": {
        "type": "boolean",
        "default": false,
        "description": "Open files without write permission on disk read-only.",
        "order": 3.3
      },
      "outline.sortOrder": {
        "type": "string",
        "enum": ["position", "name", "kind"],
        "default": "position",
        "description": "Order of symbols in the Outline: as in the file, by name, or by kind (then name)."
      },
