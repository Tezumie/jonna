{
  "name": "ide",
  "private": true,
  "version": "0.1.0",
  "description": "AI-first desktop IDE (unnamed; names live in product.json)",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/gen.mjs",
    "gen": "node scripts/gen.mjs",
    "dev": "node scripts/gen.mjs && tauri dev",
    "dev:fresh": "node scripts/dev-fresh.mjs",
    "dev:fresh-ollama": "node scripts/dev-fresh.mjs --keep-ollama",
    "build": "node scripts/gen.mjs && tauri build",
    "build:fast": "node scripts/gen.mjs && tauri build --bundles nsis -- --profile fast-release",
    "build:web": "node build.mjs --prod",
    "check": "node scripts/gen.mjs && node scripts/check-colors.mjs && node scripts/check-commands.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && biome check .",
    "fix": "biome check --write .",
    "test": "node scripts/test.mjs",
    "size": "node scripts/size.mjs",
    "licenses": "node scripts/licenses.mjs",
    "notices": "node scripts/notices.mjs",
    "tauri": "tauri",
    "test:ui": "node scripts/ui-test.mjs"
  },
  "dependencies": {
    "@shikijs/monaco": "^4.5.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "emmet-monaco-es": "5.7.0",
    "katex": "0.19.0",
    "monaco-editor": "0.57.0",
    "monaco-vim": "0.4.4",
    "pele": "1.7.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.59.0",
    "material-icon-theme": "5.39.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
