// D340: a recording of what the agent does in the browser tab. browser_act start_recording, a
// click on an element (a marker where it is, its action_summary as a caption), a pause (frames
// every second), a click by point, then stop_recording: the chat shows the GIF as a card with
// Save; ide://agent/recordings lists it; agent.saveRecording writes it into the workspace.
{
  "name": "browser-gif-m7-83",
  "steps": [
    {
      "run": "settings.set",
      "input": { "key": "agent.ollama.url", "value": "http://127.0.0.1:11999" }
    },
    {
      "run": "settings.set",
      "input": { "key": "agent.autoApprove", "value": { "browser": { "localhost": true } } }
    },
    {
      "run": "agent.refreshModels",
      "expect": [{ "model": "ollama/mock-coder:1b" }],
      "timeoutMs": 10000
    },
    { "run": "dev.setWindowSize", "input": { "width": 1400, "height": 900 } },
    { "run": "agent.newSession", "expect": { "session": { "$exists": true } } },
    {
      "run": "browser.open",
      "input": { "url": "http://localhost:11998/upload.html" },
      "expect": { "connected": true, "title": "Upload lab" },
      "timeoutMs": 20000
    },
    {
      "run": "agent.send",
      "input": { "message": "pkgL record a short gif" },
      "expect": { "answer": "pkgL record: gif" },
      "timeoutMs": 60000
    },
    // The clicks happened.
    {
      "run": "browser.eval",
      "input": { "code": "document.getElementById('count').textContent" },
      "expect": { "result": "Count 1" }
    },
    // The recording, kept until the IDE closes.
    {
      "state": "ide://agent/recordings",
      "expect": {
        "recording": { "$length": 0 },
        "recordings": [{ "frames": { "$gte": 2 }, "bytes": { "$gte": 100 } }]
      },
      "save": "recs",
      "print": true
    },
    // Its card in the chat: the GIF, what it holds, Save and Download.
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".agent-column .agent-recording", "limit": 1, "html": 3000 },
      "expect": [{ "html": { "$contains": "blob:" } }],
      "print": true
    },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".agent-column .agent-recording-caption", "limit": 1 },
      "expect": [{ "html": { "$contains": "Browser recording" } }]
    },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".agent-column .agent-recording-action", "limit": 2 },
      "expect": { "$length": 2 }
    },
    // Saved into the workspace only when asked.
    {
      "run": "agent.saveRecording",
      "input": { "id": "${recs.recordings.0.id}", "path": "recording-test.gif" },
      "expect": { "path": { "$contains": "recording-test.gif" } }
    },
    {
      "run": "terminal.runCommand",
      "input": { "command": "head -c 6 recording-test.gif", "timeoutMs": 20000 },
      "expect": { "exitCode": 0, "output": { "$contains": "GIF89a" } }
    },
    { "run": "workbench.screenshot", "input": {}, "print": true },
    { "run": "settings.set", "input": { "key": "agent.autoApprove", "value": {} } }
  ]
}
