// Close folder takes every tab's view out of the page, as closing one tab does (D237): a notebook
// open when the folder closed stayed on screen (its element was left in its group).
{
  "name": "close-folder-notebook-m7-41",
  "steps": [
    { "run": "workspace.setTrust", "input": { "trusted": true } },
    { "run": "notebook.new", "input": { "path": "nb/close.ipynb" } },
    {
      "state": "ide://notebook",
      "expect": { "active": { "cells": { "$length": 1 } } },
      "timeoutMs": 10000
    },
    { "run": "workspace.closeFolder", "expect": { "closed": true } },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".notebook-editor", "limit": 5 },
      "expect": { "$length": 0 },
      "timeoutMs": 5000
    },
    { "state": "ide://notebook", "expect": { "open": [] } }
  ]
}
