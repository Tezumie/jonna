// D278: a 10 000-line Markdown file previews without a re-render per code block: colored blocks
// are patched in as they arrive, pictures re-render once per burst, and scroll sync measures the
// blocks once and binary searches them. Each step logs its time.
{
  "name": "md-big-m7-31",
  "steps": [
    { "run": "workspace.setTrust", "input": { "trusted": true }, "expect": { "state": "trusted" } },
    { "run": "dev.setWindowSize", "input": { "width": 1300, "height": 800 } },
    {
      "run": "terminal.runCommand",
      "input": { "command": "node ../setup/big-md.cjs big.md 10000", "timeoutMs": 30000 },
      "expect": { "exitCode": 0 },
      "timeoutMs": 40000
    },
    { "run": "editor.openFile", "input": { "path": "big.md" } },
    { "run": "viewer.openPreview", "input": { "path": "big.md", "toSide": true }, "time": true },
    {
      "name": "last section shown",
      "run": "dev.inspectDom",
      "input": { "selector": ".markdown-preview h2[id='section-710']" },
      "expect": { "$length": 1 },
      "time": true,
      "timeoutMs": 20000
    },
    // Every code block colored (236 of them), without a re-render each.
    {
      "name": "a code block colored",
      "run": "dev.inspectDom",
      "input": { "selector": ".markdown-preview .md-pre code span", "limit": 1, "html": 200 },
      "expect": { "$length": 1 },
      "time": true,
      "timeoutMs": 20000
    },
    { "wait": 3000 },
    {
      "name": "all colored",
      "run": "dev.inspectDom",
      "input": { "selector": ".markdown-preview .md-pre code:not(:has(span))", "limit": 1 },
      "expect": { "$length": 0 },
      "time": true
    },
    // Scroll sync over the whole document: the editor at a line, the preview follows.
    { "run": "editor.openFile", "input": { "path": "big.md", "line": 9000 } },
    { "wait": 1500 },
    { "run": "workbench.screenshot", "input": { "save": true }, "print": true }
  ]
}
