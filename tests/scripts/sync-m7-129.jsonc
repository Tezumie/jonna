// D435: Sync as people see it, with nobody signed in (there is no sync service in UI tests; the
// signed-in flows are covered by scripts/sync-e2e.mjs): the Sync tab opens and asks to sign in,
// ide://sync says sync isn't available (nothing of the account's in `overview`), the status bar
// has no sync item, and the commands fail with a sentence that says why.
{
  "name": "sync-m7-129",
  "steps": [
    {
      "state": "ide://accounts",
      "expect": { "ide": { "available": true, "signedIn": false } }
    },

    // The tab: a singleton in the main area.
    { "run": "sync.show", "expect": { "tabId": { "$exists": true } }, "save": "tab" },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-setup-title", "html": 400 },
      "expect": [{ "html": { "$contains": "Sync" } }],
      "timeoutMs": 5000
    },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-text", "html": 600 },
      "expect": [{ "html": { "$contains": "Sign in to your account" } }],
      "timeoutMs": 5000
    },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-actions button", "html": 600 },
      "expect": [{ "html": { "$contains": "Sign in" } }]
    },
    { "run": "sync.show", "expect": { "tabId": "${tab.tabId}" } },

    // A page can be asked for (shown once sync is on; before that the tab is the one setup
    // pane, without the navigation).
    {
      "run": "sync.show",
      "input": { "page": "storage" },
      "expect": { "tabId": "${tab.tabId}", "page": "storage" }
    },
    { "state": "ide://sync", "expect": { "page": "storage" } },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-setup-scroll", "html": 10 },
      "expect": [{ "display": "block" }]
    },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-layout", "html": 10 },
      "expect": [{ "display": "none" }]
    },
    { "run": "sync.show", "input": { "page": "overview" }, "expect": { "page": "overview" } },

    // State: not available, nothing of the account's, no key material.
    {
      "state": "ide://sync",
      "expect": {
        "available": false,
        "offered": false,
        "lapsedUntil": null,
        "team": null,
        "state": "signedOut",
        "device": null,
        "devices": { "$length": 0 },
        "recoveryKeySet": false,
        "project": null,
        "snapshots": { "$length": 0 },
        "overview": {
          "settings": null,
          "files": { "$length": 0 },
          "accountChats": 0,
          "projects": { "$length": 0 }
        },
        "recent": { "$length": 0 }
      },
      "timeoutMs": 10000
    },

    // The status bar item is there only while sync is on (or waiting to be approved).
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".statusbar-item[data-id='sync.status']", "html": 10 },
      "expect": [{ "display": "none" }]
    },

    // The commands say why they can't run.
    { "run": "sync.turnOn", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.join", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.syncNow", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.snapshot.create", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.project.enable", "expectError": "Sign in to your account to use sync." },
    {
      "run": "sync.reviewDevice",
      "input": { "device": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.approveDevice",
      "input": { "device": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    { "run": "sync.project.link", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.project.editIgnore", "expectError": "Sign in to your account to use sync." },
    {
      "run": "sync.project.rename",
      "input": { "id": "none", "name": "x" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.renameDevice",
      "input": { "name": "x" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.project.forgetFolder",
      "input": { "folder": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.project.deleteFromAccount",
      "input": { "id": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    // The plan (the subscription) is the account's: nothing to open or to read signed out.
    { "run": "sync.managePlan", "expectError": "Sign in to your account to use sync." },
    // So is the team: its page isn't opened for nobody.
    { "run": "sync.manageTeam", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.checkPlan", "expectError": "Sign in to your account to use sync." },

    // The team's library (D442): signed out there is none, nothing of one is on, and the
    // commands say why instead of doing anything.
    {
      "state": "ide://team",
      "expect": { "team": null, "state": null, "items": { "$length": 0 }, "problem": null }
    },
    { "run": "team.refresh", "expect": { "team": null, "items": 0, "active": 0 } },
    {
      "run": "team.readItem",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.addItem",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.turnOffItem",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.turnOnItem",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.publish",
      "input": { "kind": "rules" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.setDefault",
      "input": { "id": "none", "isDefault": true },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.unpublish",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },

    // Its settings are known ones (a value that fits the schema is taken).
    { "run": "settings.set", "input": { "key": "sync.snapshotScope", "value": "everything" } },
    { "run": "settings.set", "input": { "key": "sync.chats", "value": false } },

    // Holds in a narrow window.
    { "run": "dev.setWindowSize", "input": { "width": 420, "height": 600 } },
    { "run": "workbench.screenshot", "input": { "save": true } }
  ]
}
