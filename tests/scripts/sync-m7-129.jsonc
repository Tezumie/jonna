// D435: Sync as people see it, with nobody signed in (there is no sync service in UI tests; the
// signed-in flows are covered by scripts/sync-e2e.mjs): the Sync tab opens and asks to sign in,
// ide://sync says sync isn't available (nothing of the account's in `overview`), the status bar
// has no sync item, and the commands fail with a sentence that says why.
{
  "name": "sync-m7-129",
  "steps": [
    {
      "state": "ide://accounts",
      "expect": { "ide": { "available": true, "signedIn": false } }
    },

    // The tab: a singleton in the main area.
    { "run": "sync.show", "expect": { "tabId": { "$exists": true } }, "save": "tab" },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-setup-title", "html": 400 },
      "expect": [{ "html": { "$contains": "Sync" } }],
      "timeoutMs": 5000
    },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-text", "html": 600 },
      "expect": [{ "html": { "$contains": "Sign in to your account" } }],
      "timeoutMs": 5000
    },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-actions button", "html": 600 },
      "expect": [{ "html": { "$contains": "Sign in" } }]
    },
    { "run": "sync.show", "expect": { "tabId": "${tab.tabId}" } },

    // A page can be asked for (shown once sync is on; before that the tab is the one setup
    // pane, without the navigation).
    {
      "run": "sync.show",
      "input": { "page": "storage" },
      "expect": { "tabId": "${tab.tabId}", "page": "storage" }
    },
    { "state": "ide://sync", "expect": { "page": "storage" } },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-setup-scroll", "html": 10 },
      "expect": [{ "display": "block" }]
    },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".sync-view .sync-layout", "html": 10 },
      "expect": [{ "display": "none" }]
    },
    { "run": "sync.show", "input": { "page": "overview" }, "expect": { "page": "overview" } },

    // State: not available, nothing of the account's, no key material.
    {
      "state": "ide://sync",
      "expect": {
        "available": false,
        "offered": false,
        "lapsedUntil": null,
        "team": null,
        "state": "signedOut",
        "device": null,
        "devices": { "$length": 0 },
        "recoveryKeySet": false,
        "project": null,
        "share": null,
        "snapshots": { "$length": 0 },
        "overview": {
          "settings": null,
          "files": { "$length": 0 },
          "accountChats": 0,
          "projects": { "$length": 0 }
        },
        "recent": { "$length": 0 }
      },
      "timeoutMs": 10000
    },

    // The status bar item is there only while sync is on (or waiting to be approved).
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".statusbar-item[data-id='sync.status']", "html": 10 },
      "expect": [{ "display": "none" }]
    },

    // The commands say why they can't run.
    { "run": "sync.turnOn", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.join", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.syncNow", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.snapshot.create", "expectError": "Sign in to your account to use sync." },
    // Looking inside a snapshot needs the account too.
    {
      "run": "sync.snapshot.files",
      "input": { "id": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.snapshot.openDiff",
      "input": { "id": "none", "path": "a.txt" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.snapshot.view",
      "input": { "id": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    { "run": "sync.project.enable", "expectError": "Sign in to your account to use sync." },
    {
      "run": "sync.reviewDevice",
      "input": { "device": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.approveDevice",
      "input": { "device": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    { "run": "sync.project.link", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.project.editIgnore", "expectError": "Sign in to your account to use sync." },
    {
      "run": "sync.project.rename",
      "input": { "id": "none", "name": "x" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.renameDevice",
      "input": { "name": "x" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.project.forgetFolder",
      "input": { "folder": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.project.deleteFromAccount",
      "input": { "id": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    // The plan (the subscription) is the account's: nothing to open or to read signed out.
    { "run": "sync.managePlan", "expectError": "Sign in to your account to use sync." },
    // So is the team: its page isn't opened for nobody.
    { "run": "sync.manageTeam", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.checkPlan", "expectError": "Sign in to your account to use sync." },

    // The team's library (D442): signed out there is none, nothing of one is on, and the
    // commands say why instead of doing anything.
    {
      "state": "ide://team",
      "expect": {
        "team": null,
        "state": null,
        "items": { "$length": 0 },
        "problem": null,
        // Sharing projects: nobody and nothing, and nothing was asked of the service.
        "members": { "$length": 0 },
        "shares": { "$length": 0 },
        "sharesRefresh": null,
        "sharesProblem": null
      }
    },
    { "run": "team.refresh", "expect": { "team": null, "items": 0, "active": 0 } },
    {
      "run": "team.readItem",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.addItem",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.turnOffItem",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.turnOnItem",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.publish",
      "input": { "kind": "rules" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.setMode",
      "input": { "id": "none", "mode": "default" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },
    {
      "run": "team.unpublish",
      "input": { "id": "none" },
      "expectError": "This account isn't in a team (or isn't signed in): there is no library."
    },

    // The Team page: a page of the tab that can be asked for (it shows once sync is on, in a
    // team or not), and publishing by picking says why it can't, signed out, before it asks
    // anything.
    { "run": "sync.show", "input": { "page": "team" }, "expect": { "page": "team" } },
    { "state": "ide://sync", "expect": { "page": "team" } },
    { "run": "sync.team.publish", "expectError": "Sign in to your account to use sync." },
    {
      "run": "sync.team.publish",
      "input": { "kind": "commands" },
      "expectError": "Sign in to your account to use sync."
    },

    // Sharing a project with the team: both sides need the account, and say so before
    // anything is asked (no dialog, no folder picker).
    { "run": "sync.project.share", "expectError": "Sign in to your account to use sync." },
    { "run": "sync.project.unshare", "expectError": "Sign in to your account to use sync." },
    {
      "run": "sync.project.unshare",
      "input": { "id": "none.none" },
      "expectError": "Sign in to your account to use sync."
    },
    { "run": "sync.project.shareNow", "expectError": "Sign in to your account to use sync." },
    { "run": "team.members", "expectError": "Sign in to your account to use sync." },
    { "run": "team.shares.list", "expectError": "Sign in to your account to use sync." },
    {
      "run": "team.share.snapshots",
      "input": { "id": "none.none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.share.files",
      "input": { "id": "none.none", "snapshot": "none", "filter": "src" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.share.openFile",
      "input": { "id": "none.none", "snapshot": "none", "path": "a.txt" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.share.view",
      "input": { "id": "none.none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.share.openCopy",
      "input": { "id": "none.none", "snapshot": "none", "target": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.member.verify",
      "input": { "uid": "none", "fingerprint": "1234 5678 9012 3456 7890", "verified": true },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.member.acceptKey",
      "input": { "uid": "none", "fingerprint": "1234 5678 9012 3456 7890" },
      "expectError": "Sign in to your account to use sync."
    },
    { "run": "team.copyFingerprint", "expectError": "Sign in to your account to use sync." },
    // D453 to D455: who a share is for, its chats, asking a teammate. The same: the
    // account first, and nothing asked of the service or of the person before that.
    {
      "run": "sync.project.share",
      "input": { "readers": ["none"] },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.project.shareWith",
      "input": { "team": true },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.project.shareWith",
      "input": { "readers": ["none"] },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "sync.project.shareChats",
      "input": { "on": true },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.share.chats",
      "input": { "id": "none.none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.share.readChat",
      "input": { "id": "none.none", "chat": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.share.continueChat",
      "input": { "id": "none.none", "chat": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    {
      "run": "team.member.askToShare",
      "input": { "uid": "none" },
      "expectError": "Sign in to your account to use sync."
    },
    { "run": "team.asks.dismiss", "expectError": "Sign in to your account to use sync." },
    { "state": "ide://team", "expect": { "asks": { "$length": 0 } } },
    // The notices' switch is a setting of this computer's, on unless turned off.
    // Nothing of it reached the page, and the tab still shows the one setup pane.
    {
      "state": "ide://team",
      "expect": { "members": { "$length": 0 }, "shares": { "$length": 0 } }
    },
    // Unpinning a snapshot (its name, and the account page's mark) needs the account too.
    {
      "run": "sync.snapshot.pin",
      "input": { "id": "none", "name": null },
      "expectError": "Sign in to your account to use sync."
    },
    { "run": "sync.show", "input": { "page": "overview" }, "expect": { "page": "overview" } },

    // Its settings are known ones (a value that fits the schema is taken).
    { "run": "settings.set", "input": { "key": "sync.snapshotScope", "value": "everything" } },
    { "run": "settings.set", "input": { "key": "sync.chats", "value": false } },
    // Sharing only with verified teammates: off unless turned on.
    { "run": "settings.set", "input": { "key": "team.shareOnlyVerified", "value": true } },

    // Holds in a narrow window.
    { "run": "dev.setWindowSize", "input": { "width": 420, "height": 600 } },
    { "run": "workbench.screenshot", "input": { "save": true } }
  ]
}
