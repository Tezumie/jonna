// Close folder with a notebook open while a VS Code extension follows notebooks (Jupyter does):
// the notebook's tab is gone afterwards and nothing opens it again.
{
  "name": "close-folder-vscode-notebook-m7-43",
  "requires": ["node"],
  "steps": [
    { "run": "workspace.setTrust", "input": { "trusted": true }, "expect": { "state": "trusted" } },
    {
      "run": "extensions.loadUnpacked",
      "input": { "folder": "../extensions/vscodehello" },
      "expect": { "id": "acme.vscode-hello" }
    },
    {
      "run": "extensions.grantPermissions",
      "input": { "id": "acme.vscode-hello", "grant": true },
      "expect": { "granted": true }
    },
    {
      "run": "extensions.try",
      "input": { "id": "acme.vscode-hello", "command": "vscodeHello.info" },
      "timeoutMs": 60000
    },
    { "run": "notebook.new", "input": { "path": "nb/close.ipynb" } },
    {
      "state": "ide://notebook",
      "expect": { "active": { "cells": { "$length": 1 } } },
      "timeoutMs": 10000
    },
    { "wait": 1500 },
    { "state": "ide://workspace", "save": "ws" },
    { "run": "workspace.closeFolder", "expect": { "closed": true } },
    // What the extension host sends while it follows a notebook (a read of its cells) can arrive
    // after the close: it is refused, where it used to open the notebook again (seen on CI).
    {
      "run": "notebook.read",
      "input": { "path": "${ws.root}/nb/close.ipynb", "ifOpen": true },
      "expectError": "open"
    },
    { "wait": 4000 },
    { "state": "ide://notebook", "print": true },
    // No notebook is open (`[]` alone matched any list: expectations match partially).
    { "state": "ide://notebook", "expect": { "open": { "$length": 0 }, "active": null } },
    {
      "run": "dev.inspectDom",
      "input": { "selector": ".notebook-editor", "limit": 5 },
      "expect": { "$length": 0 }
    }
  ]
}
